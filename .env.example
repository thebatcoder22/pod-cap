DATABASE_URL=postgres://localhost:5432/podcap

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# Google OAuth client (Web application). Redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Encrypts the Jira API token at rest: generate with `openssl rand -base64 32`.
# Changing it makes the saved token unreadable; re-enter the token on the settings page.
ENCRYPTION_KEY=

# Local Playwright only: enables an email-only test sign-in. Ignored on Vercel.
# E2E_TEST_LOGIN=1

# Vercel Cron sends this as a bearer token to /api/cron/sync: generate with `openssl rand -hex 32`.
CRON_SECRET=
